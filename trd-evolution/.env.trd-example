# ==============================================================================
# TRD EVOLUTION — CONFIGURAÇÃO OFICIAL (TRD CONSULTORIA DE TI)
# ==============================================================================

# Informações do Servidor
SERVER_TYPE=http
SERVER_PORT=8085
SERVER_URL=http://localhost:8085

# Chave Mestre de Autenticação da API
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=trd-evolution-key-2026

# Identidade da Aplicação
APPLICATION_NAME=TRD Evolution

# Configurações do Banco de Dados (PostgreSQL)
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution123@localhost:5432/evolution_db?sslmode=disable
DATABASE_CLIENT_NAME=evolution_trd

# Cache & Redis (Opcional - pode operar em LocalCache se Redis estiver inativo)
CACHE_REDIS_ENABLED=false
CACHE_REDIS_URI=redis://localhost:6379
CACHE_LOCAL_ENABLED=true

# Anthropic (Claude) - Swarm de Agentes Ativo
ANTHROPIC_ENABLED=true
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui

# Integração Webhooks & Telemetria
WEBHOOK_GLOBAL_ENABLED=false
TELEMETRY_ENABLED=false

# Instância Padrão da TRD
DEFAULT_INSTANCE_NAME=trd-whatsapp-principal
